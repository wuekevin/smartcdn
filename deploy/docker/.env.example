# Copy this file to .env and fill in real values before running docker compose up.

# 32-byte hex key for AES-256-GCM (generate with: openssl rand -hex 32)
SMARTCDN_ENCRYPT_KEY=changeme32byteshexkeyhereplease00

# MySQL
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_PASSWORD=changeme_smartcdn
DB_DSN=smartcdn:changeme_smartcdn@tcp(mysql:3306)/smartcdn?charset=utf8mb4&parseTime=True&loc=Local

# Redis (leave empty to use bundled redis container)
REDIS_URL=redis://redis:6379/0

# Log level: debug | info | warn | error
LOG_LEVEL=info
